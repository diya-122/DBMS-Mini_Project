# Copy this file to ".env" and fill in your values
PORT=5000

# PostgreSQL (the database you created in pgAdmin)
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your_pgadmin_password
PG_DATABASE=scholarship_db

# MongoDB (local MongoDB Compass / mongod, or an Atlas URI)
MONGO_URI=mongodb://127.0.0.1:27017/scholarship_nosql

JWT_SECRET=change_this_to_a_long_random_string
